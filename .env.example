# Flask
SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True

# Database (defaults to SQLite inside ./instance/)
DATABASE_URL=sqlite:///fake_news.db

# Blockchain source traceability (optional — the app works without it)
# Leave BLOCKCHAIN_CONTRACT_ADDRESS empty to run in local-hashchain-only mode.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
